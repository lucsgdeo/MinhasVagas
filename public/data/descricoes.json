            "tipo": "item",
            "texto": "Seguro de Vida"
          },
          {
            "tipo": "subtitulo",
            "texto": "Jornada e Mobilidade"
          },
          {
            "tipo": "item",
            "texto": "Carga horária de trabalho reduzida e almoço estendido."
          },
          {
            "tipo": "item",
            "texto": "Refeição no local."
