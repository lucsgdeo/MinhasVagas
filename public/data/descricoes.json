  "gupy-12799407": {
    "fonte": "texto",
    "secoes": [
      {
        "titulo": "Responsabilidades",
        "blocos": [
          {
            "tipo": "item",
            "texto": "No time de Segurança da Informação você será protagonista do maior e melhor ecossistema de beleza para o mundo."
          },
          {
            "tipo": "item",
            "texto": "A pessoa Analista Desenvolvedora III de Segurança da Informação contribuirá no desenvolvimento de produto interno IAM que tem o objetivo de criar e manter sistemas auxiliares ao Sistema de Gestão de Identidades e Acessos."
          },
          {
            "tipo": "item",
            "texto": "Como será o seu dia?"
          },
          {
            "tipo": "item",
            "texto": "Atuará como pessoa desenvolvedora em um time diverso com o desafio de continuar a construção de um produto de gestão de acessos"
          },
          {
            "tipo": "item",
            "texto": "Participará do desenho da arquitetura da solução e de cenários de hipóteses"
          },
          {
            "tipo": "item",
            "texto": "Trabalhará em um ambiente colaborativo, buscando melhoria e feedback contínuo"
          },
          {
            "tipo": "item",
            "texto": "Participará de ritos da squad e eventualmente de chapters"
          },
          {
            "tipo": "item",
            "texto": "Primordial prezar pela qualidade e segurança de código"
          },
          {
            "tipo": "item",
            "texto": "Ter mindset de Continuous Delivery, focando na entrega de valor para o negócio e cliente final."
          }
        ]
      },
      {
        "titulo": "Requisitos",
        "blocos": [
          {
            "tipo": "item",
            "texto": "É fundamental ter um jeito inquieto, questionador e muita vontade de fazer acontecer"
          },
          {
            "tipo": "item",
            "texto": "Inconformismo positivo e protagonismo"
          },
          {
            "tipo": "item",
            "texto": "Habilidade de construir relacionamentos e atuar de forma colaborativa"
