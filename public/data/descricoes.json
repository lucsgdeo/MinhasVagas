  "12765567": {
    "fonte": "html",
    "secoes": [
      {
        "titulo": "Responsabilidades",
        "blocos": [
          {
            "tipo": "item",
            "texto": "Realizar a administração correta de medicamentos prescritos, observando dosagens, vias de administração e horários, conforme orientação médica e protocolos estabelecidos;"
          },
          {
            "tipo": "item",
            "texto": "Monitorar e registrar regularmente os sinais vitais dos pacientes, como pressão arterial, temperatura, frequência cardíaca e respiratória, e comunicar qualquer alteração significativa ao enfermeiro responsável;"
          },
          {
            "tipo": "item",
            "texto": "Realizar curativos simples e complexos, garantindo a limpeza adequada e o uso de técnicas assépticas para prevenir infecções;"
          },
          {
            "tipo": "item",
            "texto": "Efetuar a coleta de amostras biológicas (sangue, urina, etc.) para exames laboratoriais, seguindo normas de biossegurança e protocolos específicos;"
          },
          {
            "tipo": "item",
            "texto": "Organizar e preparar os materiais e equipamentos necessários para a realização de procedimentos médicos e de enfermagem, garantindo que estejam prontos para uso;"
          },
          {
            "tipo": "item",
            "texto": "Prestar suporte imediato em situações de emergência, aplicando técnicas de primeiros socorros e suporte básico de vida (BLS) conforme treinamento e protocolos institucionais;"
          },
          {
            "tipo": "item",
            "texto": "Observar e relatar quaisquer alterações no estado clínico dos pacientes, como mudanças nos sinais vitais, nível de consciência ou outras condições que exijam atenção médica;"
          },
          {
            "tipo": "item",
            "texto": "Fornecer orientações básicas aos pacientes e seus familiares sobre cuidados necessários, procedimentos a serem realizados e promoção da saúde, sempre que solicitado;"
          },
          {
            "tipo": "item",
            "texto": "Documentar todas as atividades realizadas em prontuários eletrônicos ou físicos, assegurando a precisão e a confidencialidade das informações dos pacientes;"
          },
          {
            "tipo": "item",
            "texto": "Assegurar que os ambientes de trabalho, incluindo salas de procedimentos, estejam organizados e limpos, respeitando as normas de higiene hospitalar;"
          },
          {
            "tipo": "item",
            "texto": "Participar ativamente de reuniões, treinamentos e capacitações, buscando continuamente aprimorar seus conhecimentos e habilidades na área de enfermagem;"
          },
          {
            "tipo": "item",
