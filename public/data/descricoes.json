  "12814752": {
    "fonte": "html",
    "secoes": [
      {
        "titulo": "Responsabilidades",
        "blocos": [
          {
            "tipo": "item",
            "texto": "Conhecer e aplicar as leis e normativas que norteiam o CAPS,"
          },
          {
            "tipo": "item",
            "texto": "Trabalhar na atenção em saúde aos usuários com transtornos mentais graves e persistentes, baseados em diretrizes do Ministério da Saúde, Organização Mundial de saúde e Secretaria Municipal de Saúde;"
          },
          {
            "tipo": "item",
            "texto": "Planejar, realizar, praticar e prescrever tratamentos e intervenções clínicas aos usuários SUS;"
          },
          {
            "tipo": "item",
            "texto": "Receitar drogas, medicamentos e fitoterápicos;"
          },
          {
            "tipo": "item",
            "texto": "Estabelecer prognóstico e acompanhar plano terapêutico do usuário com equipe multidisciplinar e apoio matricial quando solicitado;"
          },
          {
            "tipo": "item",
            "texto": "Praticar psicoterapia (se habilitado);"
          },
          {
            "tipo": "item",
            "texto": "Reabilitar pacientes (condições biopsicossociais) priorizando a integralidade do cuidado;"
          },
          {
            "tipo": "item",
            "texto": "Indicar necessidade de internação (quando necessário);"
          },
          {
            "tipo": "item",
            "texto": "Ministrar tratamentos preventivos;"
          },
          {
            "tipo": "item",
            "texto": "Rastrear doenças prevalentes;"
          },
          {
            "tipo": "item",
            "texto": "Registrar todas as ações realizadas junto ao usuário em seu prontuário;"
          },
          {
            "tipo": "item",
            "texto": "Emitir receitas, laudos, pareceres e atestados;"
          },
          {
            "tipo": "item",
            "texto": "Elaborar protocolos e relatórios de condutas médicas;"
          },
          {
            "tipo": "item",
            "texto": "Identificar grupos, famílias e indivíduos expostos a riscos;"
          },
          {
            "tipo": "item",
            "texto": "Organizar e trabalhar com grupos visando a promoção à saúde;"
          },
          {
            "tipo": "item",
            "texto": "Identificar parceiros e recursos disponíveis na comunidade;"
          },
          {
            "tipo": "item",
            "texto": "Definir ações de acordo com prioridades locais;"
          },
          {
            "tipo": "item",
            "texto": "Desempenhar suas atividades, respeitando os princípios do Código de Ética Médica e cumprir as normas de trabalho;"
          },
          {
            "tipo": "item",
            "texto": "Prestar atendimento aos pacientes / usuários de acordo com agenda pré-determinada ou emergencial, efetuando a história clínica, exame físico e hipótese diagnóstica, realizando os procedimentos, encaminhando o paciente a exames complementares quando necessário e/ou iniciando tratamento específico;"
          },
          {
            "tipo": "item",
            "texto": "Realizar anamnese, e exame físico, realizar ou solicitar exames complementares e interconsultas;"
          },
          {
            "tipo": "item",
            "texto": "Participar de grupos e reuniões multidisciplinares com equipe de saúde e/ou usuários na unidade de saúde;"
          },
          {
            "tipo": "item",
            "texto": "Interpretar dados de exames clínicos e exames complementares;"
          },
          {
            "tipo": "item",
            "texto": "Diagnosticar estado de saúde de pacientes / usuários;"
          },
          {
            "tipo": "item",
            "texto": "Comunicar usuário sobre modificações importantes no quadro evolutivo do mesmo;"
          },
          {
            "tipo": "item",
            "texto": "Prestar informações médicas aos cuidadores, usuários, acompanhantes, familiares e /ou responsáveis, de acordo com sua capacidade de compreensão, quando solicitado e/ou necessário, em conformidade com orientação do médico assistente;"
          },
          {
            "tipo": "item",
            "texto": "Efetuar o planejamento das admissões e altas em conjunto com a equipe multiprofissional e supervisionar os cuidados clínicos efetuados na unidade;"
          },
          {
            "tipo": "item",
            "texto": "Realizar visitas, atendimentos e acompanhamentos domiciliares, quando necessário, junto a equipe multidisciplinar;"
          },
          {
            "tipo": "item",
            "texto": "Encaminhar usuários às outras especialidades;"
          },
          {
            "tipo": "item",
            "texto": "Estabelecer contato, sempre que necessário, com outros profissionais, garantindo a plena inclusão e acompanhamento do paciente na rede de saúde."
          }
