  "12700280": {
    "fonte": "texto",
    "secoes": [
      {
        "titulo": "Responsabilidades",
        "blocos": [
          {
            "tipo": "item",
            "texto": "Seu dia a dia na Conta Simples:Realizar o atendimento aos clientes por e-mail, WhatsApp e telefone, garantindo respostas dentro dos prazos estabelecidos e conforme os padrões definidos pela empresa."
          },
          {
            "tipo": "item",
            "texto": "Ser responsável por suas entregas, revisando e avaliando o impacto de suas ações nos processos e na experiência do cliente."
          },
          {
            "tipo": "item",
            "texto": "Investigar e identificar problemas operacionais de baixa complexidade, sinalizando à liderança quando necessário."
          },
          {
            "tipo": "item",
            "texto": "Contribuir com opiniões e sugestões em temas relacionados ao seu escopo de atuação, ajudando na construção de soluções."
          },
          {
            "tipo": "item",
            "texto": "Demonstrar curiosidade e vontade de aprender continuamente sobre o negócio e suas particularidades, buscando se destacar."
          },
          {
            "tipo": "item",
            "texto": "Participar de discussões sobre a viabilidade de soluções técnicas baseadas na dor do cliente, com apoio da liderança e colegas."
          },
          {
            "tipo": "item",
            "texto": "Manter uma comunicação transparente com pares e liderança, estando aberto a receber e solicitar feedbacks que contribuam para o seu desenvolvimento."
          },
          {
            "tipo": "item",
            "texto": "Exercitar a prática de dar e receber feedbacks, mesmo que ainda esteja em fase de aprendizado, contando com suporte da liderança."
          },
          {
            "tipo": "item",
            "texto": "Acionar sua liderança sempre que identificar obstáculos ou problemas no dia a dia que possam afetar a operação."
          },
          {
            "tipo": "item",
            "texto": "Atuar com proatividade em suas rotinas, participando de projetos e processos de menor complexidade na área."
          },
          {
            "tipo": "item",
            "texto": "Estar alinhado com os valores e comportamentos da nossa cultura, contribuindo para um ambiente colaborativo, responsável e centrado no cliente."
          }
        ]
      },
