            "tipo": "item",
            "texto": "Interagir com Representação de Mercado para alinhar demandas e prazos."
          },
          {
            "tipo": "item",
            "texto": "Monitorar normas, audiências e consultas públicas da CVM e do Bacen e elaborar resumos e quadros comparativos."
          },
          {
            "tipo": "item",
            "texto": "Apoiar a preparação de manifestações e respostas a consultas públicas."
          },
          {
            "tipo": "item",
            "texto": "Acompanhar a regulamentação e as discussões de mercado sobre temas jurídicos, tributários e de PLD/FTP que impactam o mercado de capitais."
          },
          {
            "tipo": "item",
            "texto": "Fazer pesquisas jurídicas e redigir minutas de notas técnicas, memorandos e pareceres, sob supervisão."
          },
          {
            "tipo": "item",
            "texto": "Acompanhar projetos de lei e proposições no Congresso Nacional relacionadas ao mercado de capitais."
          },
          {
            "tipo": "item",
            "texto": "Manter atualizado o controle de tramitação e sinalizar à liderança os temas com impacto potencial para os associados."
          },
          {
            "tipo": "item",
            "texto": "Organizar e manter a base de documentos, posicionamentos e histórico das discussões da área."
          },
          {
            "tipo": "item",
            "texto": "Elaborar comunicados e informes técnicos para associados e áreas internas."
          }
        ]
      },
      {
        "titulo": "Requisitos",
        "blocos": [
          {
            "tipo": "item",
            "texto": "Formação: graduação completa em Direito."
          },
          {
            "tipo": "item",
            "texto": "OAB: ativa ou em processo de obtenção."
          },
          {
            "tipo": "item",
            "texto": "Experiência: até 2 anos em escritório de advocacia, departamento jurídico de instituição financeira, gestora, associação de mercado ou órgão regulador."
          },
          {
            "tipo": "item",
            "texto": "Conhecimentos técnicos: noções de regulação do mercado financeiro e de capitais (CVM e Bacen), como as Resoluções CVM 160 e 175"
