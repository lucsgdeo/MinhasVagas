  "12818277": {
    "fonte": "html",
    "secoes": [
      {
        "titulo": "Responsabilidades",
        "blocos": [
          {
            "tipo": "item",
            "texto": "Contribuir para a redução do churn e aumento da retenção de clientes, através da análise dos principais motivos de cancelamento, comportamento dos clientes, resultados das ações de fidelização e identificação de oportunidades de atuação."
          },
          {
            "tipo": "texto",
            "texto": "Contribuir para a melhoria contínua da experiência nos processos de retenção, por meio da análise de feedbacks, indicadores, reclamações, motivos de contato e demais informações relacionadas à jornada do cliente, propondo ações corretivas e melhorias nos processos."
          },
          {
            "tipo": "texto",
            "texto": "Apoiar a evolução e digitalização das jornadas de fidelização, através da identificação de oportunidades de utilização de canais digitais, avaliação dos resultados das iniciativas implantadas e acompanhamento da adesão dos clientes às soluções disponibilizadas."
          },
          {
            "tipo": "texto",
            "texto": "Contribuir para a qualidade e eficiência operacional das jornadas de retenção, por meio do acompanhamento dos processos de atendimento, identificação de desvios, análise de oportunidades e suporte às áreas operacionais na implementação de melhorias."
          },
          {
            "tipo": "texto",
            "texto": "Disponibilizar informações para acompanhamento da performance da área, através da consolidação, análise e monitoramento de indicadores e KPIs relacionados à retenção, satisfação, fidelização e efetividade das iniciativas implementadas."
          },
          {
            "tipo": "texto",
            "texto": "Contribuir para a implementação de iniciativas de melhoria da experiência do cliente, por meio da participação em projetos, levantamento de necessidades, análise de cenários, acompanhamento de planos de ação e interação com áreas parceiras como Marketing, Vendas, Produto, Atendimento e Suporte."
          },
          {
            "tipo": "texto",
            "texto": "Apoiar a padronização e disseminação das práticas de retenção e fidelização, através da elaboração de materiais, compartilhamento de orientações, apoio a treinamentos e identificação de boas práticas, ferramentas e tecnologias aplicáveis aos processos da área."
          }
        ]
